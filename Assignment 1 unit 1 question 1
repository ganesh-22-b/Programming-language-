#include <stdio.h>

int main()
{
    int a;
    float b;
    char c;
    double d;

    printf("Enter an integer: ");
    scanf("%d", &a);

    printf("Enter a float: ");
    scanf("%f", &b);

    printf("Enter a character: ");
    scanf(" %c", &c);

    printf("Enter a double: ");
    scanf("%lf", &d);

    printf("\nInteger = %d", a);
    printf("\nFloat = %f", b);
    printf("\nCharacter = %c", c);
    printf("\nDouble = %lf", d);

    return 0;
}
